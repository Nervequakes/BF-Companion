<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="sg.bf.companion" android:versionCode="97" android:versionName="5.6.75">
    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="34" />
    <!-- The app shows data bundled inside it. These two are only for "Check for updates" (off unless you turn it on):
         asking GitHub for the newest release, and handing its APK to Android's installer. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <application android:label="BF Companion" android:icon="@mipmap/ic_launcher"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity android:name=".MainActivity" android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Android's answer to an update install -->
        <receiver android:name=".MainActivity$Installed" android:exported="false" />
        <!-- Copy picture: the copied picture, for the app it's pasted in (only through the clipboard) -->
        <provider android:name=".MainActivity$Pictures" android:authorities="sg.bf.companion.pictures"
            android:exported="false" android:grantUriPermissions="true" />
    </application>
</manifest>
